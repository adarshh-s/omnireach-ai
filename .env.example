# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Multi-tenant platform (optional, but required together for a real deployment
# used by multiple organizations — each org signs up, logs in, and configures
# its own WhatsApp/Email/Calendar credentials via the in-app Settings dashboard
# instead of editing this file). Without these, the app still runs standalone
# for a single business, same as before.
# ---------------------------------------------------------------------------

# 1) Supabase — stores accounts (Supabase Auth), org settings, leads' bot
#    conversations, and org->calendar links. Create a free project at
#    https://supabase.com, run supabase/schema.sql in its SQL Editor, then
#    paste these from Project Settings -> API:
#      - SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: server-only, full access, NEVER expose to the browser.
#      - VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: safe for the browser (RLS restricts each org to its own rows).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Random secret used to sign the Google OAuth "state" param so the callback can
# trust which org initiated the connect request. Any long random string.
OAUTH_STATE_SECRET=""

# 2) Meta WhatsApp webhook verification — pick any random string yourself, put
#    it here AND paste the same string into every org's Meta App Dashboard ->
#    WhatsApp -> Configuration -> Webhook -> Verify Token (one shared webhook
#    URL handles all orgs; each org points their own Meta app at it):
#    https://<your-domain>/api/whatsapp/webhook (subscribe to the "messages" field).
WHATSAPP_VERIFY_TOKEN=""

# 3) Google Calendar — one platform-level OAuth Client ID/Secret lets every org
#    click "Connect Google Calendar" in the dashboard and authorize their own
#    calendar (each org's own refresh token is stored separately, per-org, in
#    Supabase — nothing calendar-specific goes in this file per org).
#      a) Google Cloud Console -> APIs & Services -> Enable "Google Calendar API"
#      b) Create OAuth 2.0 Client ID, type "Web application", add authorized
#         redirect URI: <APP_URL>/api/auth/google/callback
#         (for local dev: http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# 4) Inbound email replies (AI email booking bot) — platform-level setup, done once by
#    whoever runs this app, using a domain you control. Two options:
#      - Cloudflare Email Routing (free, no volume limits) — see cloudflare/email-worker/README.md
#        for the full setup. EMAIL_INBOUND_DOMAIN is just your root domain (e.g. yourdomain.com).
#      - SendGrid Inbound Parse (requires a paid SendGrid plan):
#          a) Pick a subdomain for receiving mail, e.g. inbound.yourdomain.com
#          b) Add an MX record for that subdomain pointing to mx.sendgrid.net (priority 10)
#          c) In SendGrid: Settings -> Inbound Parse -> Add Host & URL
#               Receiving domain: inbound.yourdomain.com
#               Destination URL:  https://<your-app-domain>/api/email/inbound?token=<EMAIL_INBOUND_WEBHOOK_SECRET below>
#    Either way, campaign emails automatically get a Reply-To like reply+cr_<id>@<EMAIL_INBOUND_DOMAIN>
#    so a client's reply routes back to this app, and the AI replies using each org's own
#    configured "From" identity (Resend/SendGrid/SMTP/Mailgun).
#    Without this, outbound campaign email still works — only automated reply-handling needs it.
EMAIL_INBOUND_DOMAIN="yourdomain.com"
EMAIL_INBOUND_WEBHOOK_SECRET=""
